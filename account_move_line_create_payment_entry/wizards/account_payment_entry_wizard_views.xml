<odoo>
    <record id="view_account_payment_entry_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.entry.wizard.form</field>
        <field name="model">account.payment.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Payment Entry">
                <group>
                    <field name="credit_account_id" />
                    <field name="date" />
                </group>
                <footer>
                    <button
                        name="create_payment_entry"
                        type="object"
                        string="Create Payment Entry"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
